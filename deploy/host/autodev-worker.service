[Unit]
Description=AutoDev worker (developer slots + delivery)
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/autodev
EnvironmentFile=/etc/autodev/worker.env
Environment=HOME=/root
Environment=PATH=/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# --no-sync: the env is prepared by autodev-update.sh (with the qa extra).
ExecStart=/root/.local/bin/uv run --no-sync python -m autodev
Restart=always
RestartSec=10
# SIGTERM goes to the worker only: it stops taking tasks and waits for running
# Claude sessions (AUTODEV_CLAUDE_TIMEOUT, 45 min) before exiting. Whatever is
# still in progress after the timeout is killed and requeued on the next start.
KillMode=mixed
TimeoutStopSec=50min

[Install]
WantedBy=multi-user.target
